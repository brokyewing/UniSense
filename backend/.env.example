# ==========================================================
# UniSense — Environment Configuration (template)
# Copy to .env and fill in values.
# ==========================================================

# --- Uygulama ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002
APP_LOG_LEVEL=INFO
# Opsiyonel GlitchTip / Sentry hata izleme DSN (boşsa devre dışı)
GLITCHTIP_DSN=

# --- LLM: Gemini ---
GEMINI_API_KEYS=
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
GEMINI_MODEL_QUALITY=gemini-2.5-flash

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/embeddings/chromadb
CHROMA_COLLECTION=unisense
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Index sağlayıcısı: local (Model2Vec, varsayılan) | gemini
EMBEDDING_PROVIDER=local
# HF'den hazır index indirme (opsiyonel; boşsa atlanır)
HF_INDEX_REPO=BrokyEwing/unisense-index

# --- Güvenlik ---
SECURITY_REQUIRE_API_KEY=false
SECURITY_API_KEYS=
# Firebase ID token doğrulaması — local dev'de false, production'da true
SECURITY_REQUIRE_AUTH=false
FIREBASE_PROJECT_ID=unisense-13634
RATE_LIMIT_ASK=20
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_ASK_DAILY=60
RATE_LIMIT_ASK_DAILY_GLOBAL=1200
CORS_ALLOWED_ORIGINS=https://www.unisense.com.tr,https://unisense.com.tr,http://localhost:5173,http://localhost:5174
AUDIT_LOG_PATH=./logs/audit.log

# --- Firebase Admin SDK (Push Notifications) ---
# Option 1: path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Option 2: inline JSON (for cloud deployments like Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Dış servisler (veri kaynakları) ---
YOK_ATLAS_BASE=https://yokatlas.yok.gov.tr
OSYM_BASE=https://www.osym.gov.tr
URAP_BASE=https://www.urapcenter.org
HF_TOKEN=
APIFY_TOKEN=
JOOBLE_API_KEY=
CAREERJET_API_KEY=